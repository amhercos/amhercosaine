---
type Props = { slug: string };

const { slug } = Astro.props;

const diagrams: Record<string, { title: string; caption: string }> = {
  bizflow: { title: 'BizFlow layered architecture', caption: 'clients → API → domain → stores' },
  'legacy-saas-modernization': { title: 'Legacy Framework to .NET 10 migration', caption: 'framework → .NET 10 API → data' },
  amsentry: { title: 'AMSentry hardware-to-cloud flow', caption: 'device → bridge → API' },
  readtounlock: { title: 'ReadToUnlock progress unlock flow', caption: 'student → progress → unlock' },
};

const meta = diagrams[slug];
---

{meta && (
  <figure class="diagram" aria-label={meta.title}>
    <figcaption class="diagram-caption">
      <span>{meta.title}</span>
      <span>{meta.caption}</span>
    </figcaption>
    <div class="diagram-canvas">
      {slug === 'bizflow' && (
        <svg viewBox="0 0 720 280" role="img">
          <title>BizFlow layered architecture</title>
          <rect x="24" y="28" width="150" height="72" fill="#080c11" stroke="#73d3cf" />
          <text x="99" y="58" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">Clients</text>
          <text x="99" y="78" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Web · Mobile</text>
          <rect x="214" y="28" width="176" height="72" fill="#080c11" stroke="#9ab4c4" />
          <text x="302" y="58" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">ASP.NET API</text>
          <text x="302" y="78" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">CQRS · MediatR</text>
          <rect x="430" y="28" width="266" height="72" fill="#080c11" stroke="#9ab4c4" />
          <text x="563" y="58" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">Application + Domain</text>
          <text x="563" y="78" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Sales · Inventory · Credits</text>
          <rect x="142" y="168" width="176" height="72" fill="#080c11" stroke="#7dcf8c" />
          <text x="230" y="198" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">PostgreSQL</text>
          <text x="230" y="218" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Schema-per-tenant</text>
          <rect x="378" y="168" width="176" height="72" fill="#080c11" stroke="#7dcf8c" />
          <text x="466" y="198" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">SQLite</text>
          <text x="466" y="218" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Local / provider path</text>
          <path d="M174 64h40" stroke="#73d3cf" />
          <path d="M390 64h40" stroke="#73d3cf" />
          <path d="M302 100v28H230v40" stroke="#73d3cf" fill="none" />
          <path d="M563 100v28H466v40" stroke="#73d3cf" fill="none" />
        </svg>
      )}

      {slug === 'legacy-saas-modernization' && (
        <svg viewBox="0 0 720 280" role="img">
          <title>Legacy Framework to .NET 10 migration</title>
          <rect x="24" y="94" width="176" height="92" fill="#080c11" stroke="#9ab4c4" />
          <text x="112" y="132" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">.NET Framework</text>
          <text x="112" y="154" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Legacy SaaS</text>
          <rect x="268" y="36" width="184" height="208" fill="#080c11" stroke="#73d3cf" />
          <text x="360" y="88" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">.NET 10 Web API</text>
          <text x="360" y="118" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Vertical slices</text>
          <text x="360" y="140" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">CQRS + MediatR</text>
          <text x="360" y="162" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">FluentValidation</text>
          <text x="360" y="184" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Repo + Auth</text>
          <rect x="520" y="94" width="176" height="92" fill="#080c11" stroke="#7dcf8c" />
          <text x="608" y="132" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">Modern data layer</text>
          <text x="608" y="154" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">EF Core + SQL</text>
          <path d="M200 140h68" stroke="#73d3cf" />
          <path d="M452 140h68" stroke="#73d3cf" />
        </svg>
      )}

      {slug === 'amsentry' && (
        <svg viewBox="0 0 720 280" role="img">
          <title>AMSentry hardware-to-cloud flow</title>
          <rect x="24" y="94" width="160" height="92" fill="#080c11" stroke="#9ab4c4" />
          <text x="104" y="132" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">ZKTeco</text>
          <text x="104" y="154" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Fingerprint devices</text>
          <rect x="228" y="94" width="176" height="92" fill="#080c11" stroke="#73d3cf" />
          <text x="316" y="132" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">WinForms bridge</text>
          <text x="316" y="154" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">SDK + sync engine</text>
          <rect x="448" y="36" width="248" height="208" fill="#080c11" stroke="#7dcf8c" />
          <text x="572" y="102" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">AMSentry API</text>
          <text x="572" y="132" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Clean Architecture</text>
          <text x="572" y="154" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">High-frequency logs</text>
          <text x="572" y="176" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Central attendance DB</text>
          <path d="M184 140h44" stroke="#73d3cf" />
          <path d="M404 140h44" stroke="#73d3cf" />
        </svg>
      )}

      {slug === 'readtounlock' && (
        <svg viewBox="0 0 720 280" role="img">
          <title>ReadToUnlock progress unlock flow</title>
          <rect x="36" y="94" width="176" height="92" fill="#080c11" stroke="#9ab4c4" />
          <text x="124" y="132" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">Student</text>
          <text x="124" y="154" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Reading tasks</text>
          <rect x="268" y="94" width="176" height="92" fill="#080c11" stroke="#73d3cf" />
          <text x="356" y="132" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">Progress engine</text>
          <text x="356" y="154" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Milestones</text>
          <rect x="500" y="94" width="176" height="92" fill="#080c11" stroke="#7dcf8c" />
          <text x="588" y="132" fill="#f1ece2" text-anchor="middle" font-size="14" font-family="IBM Plex Sans, Segoe UI, sans-serif">Unlock gate</text>
          <text x="588" y="154" fill="#93a0ab" text-anchor="middle" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">Next content</text>
          <path d="M212 140h56" stroke="#73d3cf" />
          <path d="M444 140h56" stroke="#73d3cf" />
        </svg>
      )}
    </div>
  </figure>
)}
