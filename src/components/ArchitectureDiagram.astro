---
const PROJECT_SLUGS = ['bizflow', 'legacy-saas-modernization', 'amsentry', 'readtounlock'] as const;

type ProjectSlug = (typeof PROJECT_SLUGS)[number];
type Props = { slug: string };

const { slug } = Astro.props;
const knownSlug = (PROJECT_SLUGS as readonly string[]).includes(slug) ? (slug as ProjectSlug) : undefined;
---

<figure class="diagram">
  {knownSlug === 'bizflow' && (
    <svg viewBox="0 0 720 280" role="img" aria-labelledby="diagram-bizflow">
      <title id="diagram-bizflow">BizFlow layered architecture</title>
      <rect x="20" y="30" width="160" height="70" rx="12" fill="#11181f" stroke="#7ad4d4" />
      <text x="100" y="60" fill="#ece7dc" text-anchor="middle" font-size="14">Clients</text>
      <text x="100" y="80" fill="#9aa8b4" text-anchor="middle" font-size="11">Web · Mobile</text>
      <rect x="220" y="30" width="180" height="70" rx="12" fill="#11181f" stroke="#9ab0c4" />
      <text x="310" y="60" fill="#ece7dc" text-anchor="middle" font-size="14">ASP.NET API</text>
      <text x="310" y="80" fill="#9aa8b4" text-anchor="middle" font-size="11">CQRS · MediatR</text>
      <rect x="440" y="30" width="250" height="70" rx="12" fill="#11181f" stroke="#9ab0c4" />
      <text x="565" y="60" fill="#ece7dc" text-anchor="middle" font-size="14">Application + Domain</text>
      <text x="565" y="80" fill="#9aa8b4" text-anchor="middle" font-size="11">Sales · Inventory · Credits</text>
      <rect x="140" y="170" width="180" height="70" rx="12" fill="#11181f" stroke="#8fca8f" />
      <text x="230" y="200" fill="#ece7dc" text-anchor="middle" font-size="14">PostgreSQL</text>
      <text x="230" y="220" fill="#9aa8b4" text-anchor="middle" font-size="11">Schema-per-tenant</text>
      <rect x="380" y="170" width="180" height="70" rx="12" fill="#11181f" stroke="#8fca8f" />
      <text x="470" y="200" fill="#ece7dc" text-anchor="middle" font-size="14">SQLite</text>
      <text x="470" y="220" fill="#9aa8b4" text-anchor="middle" font-size="11">Local / provider path</text>
      <line x1="180" y1="100" x2="220" y2="100" stroke="#7ad4d4" />
      <line x1="400" y1="100" x2="440" y2="100" stroke="#7ad4d4" />
      <line x1="310" y1="100" x2="230" y2="170" stroke="#7ad4d4" />
      <line x1="565" y1="100" x2="470" y2="170" stroke="#7ad4d4" />
    </svg>
  )}

  {knownSlug === 'legacy-saas-modernization' && (
    <svg viewBox="0 0 720 280" role="img" aria-labelledby="diagram-legacy">
      <title id="diagram-legacy">Legacy Framework to .NET 10 migration</title>
      <rect x="20" y="90" width="180" height="90" rx="12" fill="#11181f" stroke="#9ab0c4" />
      <text x="110" y="125" fill="#ece7dc" text-anchor="middle" font-size="14">.NET Framework</text>
      <text x="110" y="147" fill="#9aa8b4" text-anchor="middle" font-size="11">Legacy SaaS</text>
      <rect x="270" y="40" width="180" height="190" rx="12" fill="#11181f" stroke="#7ad4d4" />
      <text x="360" y="80" fill="#ece7dc" text-anchor="middle" font-size="14">.NET 10 Web API</text>
      <text x="360" y="110" fill="#9aa8b4" text-anchor="middle" font-size="11">Vertical slices</text>
      <text x="360" y="132" fill="#9aa8b4" text-anchor="middle" font-size="11">CQRS + MediatR</text>
      <text x="360" y="154" fill="#9aa8b4" text-anchor="middle" font-size="11">FluentValidation</text>
      <text x="360" y="176" fill="#9aa8b4" text-anchor="middle" font-size="11">Repo + Auth</text>
      <rect x="520" y="90" width="180" height="90" rx="12" fill="#11181f" stroke="#8fca8f" />
      <text x="610" y="125" fill="#ece7dc" text-anchor="middle" font-size="14">Modern data layer</text>
      <text x="610" y="147" fill="#9aa8b4" text-anchor="middle" font-size="11">EF Core + SQL</text>
      <line x1="200" y1="135" x2="270" y2="135" stroke="#7ad4d4" />
      <line x1="450" y1="135" x2="520" y2="135" stroke="#7ad4d4" />
    </svg>
  )}

  {knownSlug === 'amsentry' && (
    <svg viewBox="0 0 720 280" role="img" aria-labelledby="diagram-amsentry">
      <title id="diagram-amsentry">AMSentry hardware-to-cloud flow</title>
      <rect x="20" y="90" width="160" height="90" rx="12" fill="#11181f" stroke="#9ab0c4" />
      <text x="100" y="125" fill="#ece7dc" text-anchor="middle" font-size="14">ZKTeco</text>
      <text x="100" y="147" fill="#9aa8b4" text-anchor="middle" font-size="11">Fingerprint devices</text>
      <rect x="230" y="90" width="180" height="90" rx="12" fill="#11181f" stroke="#7ad4d4" />
      <text x="320" y="125" fill="#ece7dc" text-anchor="middle" font-size="14">WinForms bridge</text>
      <text x="320" y="147" fill="#9aa8b4" text-anchor="middle" font-size="11">SDK + sync engine</text>
      <rect x="460" y="40" width="230" height="190" rx="12" fill="#11181f" stroke="#8fca8f" />
      <text x="575" y="95" fill="#ece7dc" text-anchor="middle" font-size="14">AMSentry API</text>
      <text x="575" y="125" fill="#9aa8b4" text-anchor="middle" font-size="11">Clean Architecture</text>
      <text x="575" y="147" fill="#9aa8b4" text-anchor="middle" font-size="11">High-frequency logs</text>
      <text x="575" y="169" fill="#9aa8b4" text-anchor="middle" font-size="11">Central attendance DB</text>
      <line x1="180" y1="135" x2="230" y2="135" stroke="#7ad4d4" />
      <line x1="410" y1="135" x2="460" y2="135" stroke="#7ad4d4" />
    </svg>
  )}

  {knownSlug === 'readtounlock' && (
    <svg viewBox="0 0 720 280" role="img" aria-labelledby="diagram-readtounlock">
      <title id="diagram-readtounlock">ReadToUnlock progress unlock flow</title>
      <rect x="40" y="90" width="180" height="90" rx="12" fill="#11181f" stroke="#9ab0c4" />
      <text x="130" y="125" fill="#ece7dc" text-anchor="middle" font-size="14">Student</text>
      <text x="130" y="147" fill="#9aa8b4" text-anchor="middle" font-size="11">Reading tasks</text>
      <rect x="270" y="90" width="180" height="90" rx="12" fill="#11181f" stroke="#7ad4d4" />
      <text x="360" y="125" fill="#ece7dc" text-anchor="middle" font-size="14">Progress engine</text>
      <text x="360" y="147" fill="#9aa8b4" text-anchor="middle" font-size="11">Milestones</text>
      <rect x="500" y="90" width="180" height="90" rx="12" fill="#11181f" stroke="#8fca8f" />
      <text x="590" y="125" fill="#ece7dc" text-anchor="middle" font-size="14">Unlock gate</text>
      <text x="590" y="147" fill="#9aa8b4" text-anchor="middle" font-size="11">Next content</text>
      <line x1="220" y1="135" x2="270" y2="135" stroke="#7ad4d4" />
      <line x1="450" y1="135" x2="500" y2="135" stroke="#7ad4d4" />
    </svg>
  )}
  {!knownSlug && <p>Architecture overview is not available for this case study.</p>}
</figure>
