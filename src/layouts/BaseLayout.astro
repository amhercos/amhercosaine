---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { profile } from '../data/profile';

type JsonLd = Record<string, unknown>;

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  extraJsonLd?: JsonLd | JsonLd[];
};

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  extraJsonLd,
} = Astro.props;

const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const pageDescription = description ?? profile.intro;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site?.href ?? 'https://amhercosaine.vercel.app/';
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://amhercosaine.vercel.app/');
const personId = `${new URL('/#person', Astro.site)}`;
const websiteId = `${new URL('/#website', Astro.site)}`;
const isHome = Astro.url.pathname === '/';
const isResume = Astro.url.pathname === '/resume';
const extraNodes = extraJsonLd ? (Array.isArray(extraJsonLd) ? extraJsonLd : [extraJsonLd]) : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      jobTitle: profile.role,
      description: profile.about,
      email: profile.email,
      url: siteUrl,
      sameAs: [profile.socials.github, profile.socials.linkedin],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Taguig',
        addressCountry: 'PH',
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: `${profile.name} · ${profile.role}`,
      url: siteUrl,
      description: profile.intro,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
    ...extraNodes,
  ],
};

const jsonLdScript = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.headline}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ClientRouter />
    <script is:inline>
      (() => {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('motion-ready');
        }
        window.setTimeout(() => {
          if (!document.documentElement.hasAttribute('data-motion-boot')) {
            document.documentElement.classList.add('motion-fallback');
          }
        }, 900);
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={jsonLdScript} />
  </head>
  <body class:list={[isResume && 'page-resume']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-frame">
      <div class="site-chrome" transition:persist="chrome">
        <div class="console-bar">
          <div class="shell">
            <span class="status-live">{profile.availability}</span>
            <span>Taguig, PH · Remote</span>
          </div>
        </div>
        <header class="site-header">
        <div class="shell header-inner">
          <a class="brand" href="/" aria-current={isHome ? 'page' : undefined}>
            <img class="brand-mark" src="/favicon.svg" width="36" height="36" alt="" />
            <span class="brand-name">{profile.shortName}</span>
            <span class="brand-role">{profile.role}</span>
          </a>
          <input class="nav-toggle" id="nav-toggle" type="checkbox" tabindex="-1" aria-hidden="true" />
          <label
            class="menu-button"
            for="nav-toggle"
            id="nav-menu-button"
            role="button"
            aria-label="Toggle navigation"
            aria-controls="site-nav"
            aria-expanded="false"
            tabindex="0"
          >
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 17h16"></path></svg>
          </label>
          <nav class="nav-links" id="site-nav" aria-label="Primary">
            <a href="/#work">Work</a>
            <a href="/#approach">Approach</a>
            <a href="/#experience">Experience</a>
            <a href="/resume" aria-current={isResume ? 'page' : undefined}>Résumé</a>
            <a class="nav-cta" href="/#contact">Contact</a>
          </nav>
        </div>
      </header>
      </div>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="shell site-footer">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span class="status-ok">Built carefully. Running normally.</span>
        <a href="#main">Back to top</a>
      </footer>
    </div>
    <script>
      const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const sectionIds = ['work', 'approach', 'experience', 'contact'];
      let ticking = false;

      const bindNav = () => {
        const toggle = document.getElementById('nav-toggle');
        const button = document.getElementById('nav-menu-button');
        const nav = document.getElementById('site-nav');
        if (!(toggle instanceof HTMLInputElement) || !(button instanceof HTMLElement)) return;
        if (button.dataset.bound === 'true') return;
        button.dataset.bound = 'true';

        const syncExpanded = () => {
          button.setAttribute('aria-expanded', String(toggle.checked));
        };

        syncExpanded();
        toggle.addEventListener('change', syncExpanded);

        button.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            toggle.checked = !toggle.checked;
            toggle.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.checked) {
            toggle.checked = false;
            toggle.dispatchEvent(new Event('change', { bubbles: true }));
            button.focus();
          }
        });

        nav?.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            if (toggle.checked) {
              toggle.checked = false;
              toggle.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        });
      };

      const reveal = () => {
        document.documentElement.setAttribute('data-motion-boot', '');
        const nodes = document.querySelectorAll('[data-reveal]:not(.is-in)');
        if (!motionOk) {
          nodes.forEach((node) => node.classList.add('is-in'));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0, rootMargin: '0px 0px -10% 0px' },
        );
        nodes.forEach((node) => observer.observe(node));
      };

      const syncChrome = () => {
        document.querySelector('.site-chrome')?.classList.toggle('is-scrolled', window.scrollY > 10);
      };

      const syncNav = () => {
        const links = document.querySelectorAll('.nav-links a[href*="#"]');
        const y = window.scrollY + 128;
        let current = '';
        for (const id of sectionIds) {
          const section = document.getElementById(id);
          if (section && section.offsetTop <= y) current = id;
        }
        links.forEach((link) => {
          const href = link.getAttribute('href') ?? '';
          const id = href.split('#')[1];
          link.toggleAttribute('data-active', Boolean(current && id === current));
        });
      };

      const syncPageCurrent = () => {
        const resumeLink = document.querySelector('.nav-links a[href="/resume"]');
        if (resumeLink instanceof HTMLAnchorElement) {
          if (location.pathname === '/resume') resumeLink.setAttribute('aria-current', 'page');
          else resumeLink.removeAttribute('aria-current');
        }
        const brand = document.querySelector('.brand');
        if (brand instanceof HTMLAnchorElement) {
          if (location.pathname === '/') brand.setAttribute('aria-current', 'page');
          else brand.removeAttribute('aria-current');
        }

        const toggle = document.getElementById('nav-toggle');
        const button = document.getElementById('nav-menu-button');
        if (toggle instanceof HTMLInputElement && toggle.checked) {
          toggle.checked = false;
          toggle.dispatchEvent(new Event('change', { bubbles: true }));
          button?.setAttribute('aria-expanded', 'false');
        }
      };

      const scrollToHash = () => {
        let id = '';
        try {
          id = decodeURIComponent(window.location.hash.replace('#', ''));
        } catch {
          return;
        }
        if (!id) return;
        const target = document.getElementById(id);
        if (!(target instanceof HTMLElement)) return;
        const behavior = motionOk ? 'smooth' : 'auto';
        requestAnimationFrame(() => {
          target.scrollIntoView({ block: 'start', behavior });
        });
      };

      const boot = () => {
        bindNav();
        reveal();
        syncChrome();
        syncNav();
        syncPageCurrent();
        scrollToHash();
      };

      document.addEventListener('astro:page-load', boot);
      boot();

      if (!document.documentElement.hasAttribute('data-scroll-bound')) {
        document.documentElement.setAttribute('data-scroll-bound', '');
        window.addEventListener(
          'scroll',
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              syncChrome();
              syncNav();
              ticking = false;
            });
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
