---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { profile } from '../data/profile';

type JsonLd = Record<string, unknown>;

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  extraJsonLd?: JsonLd | JsonLd[];
};

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  extraJsonLd,
} = Astro.props;

const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.role}`;
const pageDescription = description ?? profile.intro;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = Astro.site?.href ?? 'https://amhercosaine.vercel.app/';
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://amhercosaine.vercel.app/');
const personId = `${new URL('/#person', Astro.site)}`;
const websiteId = `${new URL('/#website', Astro.site)}`;
const isHome = Astro.url.pathname === '/';
const isResume = Astro.url.pathname === '/resume';
const extraNodes = extraJsonLd ? (Array.isArray(extraJsonLd) ? extraJsonLd : [extraJsonLd]) : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: profile.name,
      jobTitle: profile.role,
      description: profile.about,
      email: profile.email,
      url: siteUrl,
      sameAs: [profile.socials.github, profile.socials.linkedin],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Taguig',
        addressCountry: 'PH',
      },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: `${profile.name} | ${profile.role}`,
      url: siteUrl,
      description: profile.intro,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
    ...extraNodes,
  ],
};

const jsonLdScript = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <ClientRouter />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('portfolio-theme');
          document.documentElement.dataset.theme = saved === 'dark' ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={jsonLdScript} />
  </head>
  <body class:list={[isResume && 'page-resume']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-frame">
      <header class="site-chrome" transition:persist="chrome">
        <div class="route-progress" id="route-progress" aria-hidden="true"></div>
        <div class="shell header-inner">
          <a class="wordmark" href="/" aria-current={isHome ? 'page' : undefined}>
            {profile.shortName}
          </a>

          <div class="header-controls">
            <input class="nav-toggle" id="nav-toggle" type="checkbox" tabindex="-1" aria-hidden="true" />
            <nav class="nav-links" id="site-nav" aria-label="Primary">
              <a href="/#systems">Systems</a>
              <a href="/#experience">Experience</a>
              <a href="/#skills">Stack</a>
              <a href="/#contact">Contact</a>
            </nav>

            <button
              type="button"
              id="theme-toggle"
              class="theme-toggle"
              aria-label="Switch color theme"
              aria-pressed="false"
            >
              Dark
            </button>

            <label
              class="menu-button"
              for="nav-toggle"
              id="nav-menu-button"
              role="button"
              aria-label="Toggle navigation"
              aria-controls="site-nav"
              aria-expanded="false"
              tabindex="0"
            >
              Menu
            </label>
          </div>
        </div>
      </header>

      <main id="main" class="page-enter" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="shell footer-inner">
          <span>© {new Date().getFullYear()} {profile.name}</span>
          <a href="/resume" aria-current={isResume ? 'page' : undefined}>Résumé</a>
          <a href="#main">Top</a>
        </div>
      </footer>
    </div>

    <script>
      const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const sectionIds = ['systems', 'experience', 'skills', 'contact'];
      let ticking = false;

      const applyTheme = (theme: 'light' | 'dark') => {
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('portfolio-theme', theme);
        } catch {
          // Ignore storage restrictions
        }
        const btn = document.getElementById('theme-toggle');
        if (btn) {
          const isDark = theme === 'dark';
          btn.setAttribute('aria-pressed', String(isDark));
          btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
          btn.textContent = isDark ? 'Light' : 'Dark';
        }
      };

      const bindTheme = () => {
        let current: 'light' | 'dark' = 'light';
        try {
          current = localStorage.getItem('portfolio-theme') === 'dark' ? 'dark' : 'light';
        } catch {
          current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        }
        applyTheme(current);

        const btn = document.getElementById('theme-toggle');
        if (!(btn instanceof HTMLButtonElement)) return;
        if (btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';

        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          applyTheme(next);
        });
      };

      const bindNav = () => {
        const toggle = document.getElementById('nav-toggle');
        const button = document.getElementById('nav-menu-button');
        const nav = document.getElementById('site-nav');
        if (!(toggle instanceof HTMLInputElement) || !(button instanceof HTMLElement)) return;
        if (button.dataset.bound === 'true') return;
        button.dataset.bound = 'true';

        const syncExpanded = () => {
          button.setAttribute('aria-expanded', String(toggle.checked));
        };

        syncExpanded();
        toggle.addEventListener('change', syncExpanded);

        button.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            toggle.checked = !toggle.checked;
            toggle.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.checked) {
            toggle.checked = false;
            toggle.dispatchEvent(new Event('change', { bubbles: true }));
            button.focus();
          }
        });

        nav?.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            if (toggle.checked) {
              toggle.checked = false;
              toggle.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        });
      };

      const syncNav = () => {
        const links = document.querySelectorAll('.nav-links a[href*="#"]');
        const y = window.scrollY + 120;
        let current = '';
        for (const id of sectionIds) {
          const section = document.getElementById(id);
          if (section && section.offsetTop <= y) current = id;
        }
        links.forEach((link) => {
          const href = link.getAttribute('href') ?? '';
          const id = href.split('#')[1];
          link.toggleAttribute('data-active', Boolean(current && id === current));
        });
      };

      const syncPageCurrent = () => {
        const wordmark = document.querySelector('.wordmark');
        if (wordmark instanceof HTMLAnchorElement) {
          if (location.pathname === '/') wordmark.setAttribute('aria-current', 'page');
          else wordmark.removeAttribute('aria-current');
        }

        const toggle = document.getElementById('nav-toggle');
        const button = document.getElementById('nav-menu-button');
        if (toggle instanceof HTMLInputElement && toggle.checked) {
          toggle.checked = false;
          toggle.dispatchEvent(new Event('change', { bubbles: true }));
          button?.setAttribute('aria-expanded', 'false');
        }
      };

      const scrollToHash = () => {
        let id = '';
        try {
          id = decodeURIComponent(window.location.hash.replace('#', ''));
        } catch {
          return;
        }
        if (!id) return;
        const target = document.getElementById(id);
        if (!(target instanceof HTMLElement)) return;
        const behavior = motionOk ? 'smooth' : 'auto';
        requestAnimationFrame(() => {
          target.scrollIntoView({ block: 'start', behavior });
        });
      };

      const boot = () => {
        bindTheme();
        bindNav();
        syncNav();
        syncPageCurrent();
        scrollToHash();
      };

      let progressTimer = 0;
      const triggerRouteProgress = () => {
        const bar = document.getElementById('route-progress');
        if (!bar) return;
        window.clearTimeout(progressTimer);
        bar.classList.remove('is-active');
        void bar.offsetWidth;
        bar.classList.add('is-active');
        progressTimer = window.setTimeout(() => {
          bar.classList.remove('is-active');
        }, 420);
      };

      document.addEventListener('astro:before-preparation', () => {
        triggerRouteProgress();
      });

      document.addEventListener('astro:after-swap', () => {
        let theme: 'light' | 'dark' = 'light';
        try {
          theme = localStorage.getItem('portfolio-theme') === 'dark' ? 'dark' : 'light';
        } catch {
          theme = 'light';
        }
        document.documentElement.dataset.theme = theme;

        const main = document.getElementById('main');
        if (main && motionOk) {
          main.classList.remove('page-enter');
          void main.offsetWidth;
          main.classList.add('page-enter');
        }
      });

      document.addEventListener('astro:page-load', () => {
        boot();
      });
      boot();

      if (!document.documentElement.hasAttribute('data-scroll-bound')) {
        document.documentElement.setAttribute('data-scroll-bound', '');
        window.addEventListener(
          'scroll',
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              syncNav();
              ticking = false;
            });
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
