---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page is not part of the portfolio."
  noindex
>
  <section class="shell not-found">
    <p class="not-found-code">HTTP 404</p>
    <h1>This page does not exist.</h1>
    <p>The site is running normally, but this route is not registered.</p>
    <div>
      <a class="btn-solid-dark" href="/">Return home</a>
    </div>
  </section>
</BaseLayout>
