---
import BaseLayout from '../layouts/BaseLayout.astro';
import CopyEmailButton from '../components/CopyEmailButton.tsx';
import SystemsStudio from '../components/SystemsStudio.tsx';
import TechStackMatrix from '../components/TechStackMatrix.tsx';
import {
  education,
  experience,
  profile,
} from '../data/profile';
import { resumePdfFilename, resumePdfHref } from '../data/resume';
---

<BaseLayout>
  <!-- Section 1: Hero with Subtle Architectural Dot-Grid & Staggered Fade-Up -->
  <section class="band band-white hero-band">
    <div class="hero-dot-backdrop" aria-hidden="true"></div>
    <div class="shell hero-inner">
      <p class="hero-kicker hero-stagger" style="--stagger: 0">{profile.role}</p>
      <h1 class="hero-stagger" style="--stagger: 1">{profile.name}</h1>
      <p class="hero-availability hero-stagger" style="--stagger: 2">
        <span class="availability-dot" aria-hidden="true"></span>
        <span>{profile.availability}</span>
      </p>
      <p class="hero-subtitle hero-stagger" style="--stagger: 3">{profile.thesis}</p>

      <div class="hero-actions hero-stagger" style="--stagger: 4">
        <a
          class="btn-solid-dark"
          href={resumePdfHref}
          download={resumePdfFilename}
        >
          <span>Download Resume</span>
        </a>
        <a
          class="hero-text-link"
          href={profile.socials.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        <a
          class="hero-text-link"
          href={profile.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
        <CopyEmailButton client:load variant="link" />
      </div>
    </div>
  </section>

  <!-- Section 2: Interactive Systems Studio (Gane-Sarson DFDs + Dynamic Project Theme) -->
  <section class="band band-surface" id="systems">
    <div class="shell">
      <div class="band-header">
        <h2>Interactive Systems Studio</h2>
        <p>
          Gane-Sarson data flow diagrams across three production .NET architectures.
        </p>
      </div>

      <SystemsStudio client:load />
    </div>
  </section>

  <!-- Section 3: Compact 2-Column Experience Timeline -->
  <section class="band band-white" id="experience">
    <div class="shell">
      <div class="band-header">
        <h2>Experience</h2>
        <p>Enterprise .NET modernization, multi-tenant SaaS delivery, and biometric systems.</p>
      </div>

      <div class="exp-list">
        {experience.map((item) => (
          <article class="exp-row">
            <div class="exp-date-col">
              <time datetime={item.start}>{item.period}</time>
              <span class="exp-mode">{item.mode}</span>
            </div>

            <div class="exp-body-col">
              <div class="exp-role-line">
                <div>
                  <h3>{item.role}</h3>
                  <p class="exp-company">{item.company}</p>
                </div>
                {item.href && (
                  <a class="plain-case-link" href={item.href}>
                    Case study →
                  </a>
                )}
              </div>

              <ul class="exp-bullets">
                {item.impacts.map((impact) => (
                  <li>
                    <strong>{impact.lead}</strong> {impact.text}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}

        <article class="exp-row exp-education">
          <div class="exp-date-col">
            <time datetime="2022-08">{education.period}</time>
            <span class="exp-mode">Degree</span>
          </div>
          <div class="exp-body-col">
            <div class="exp-role-line">
              <div>
                <h3>{education.degree}</h3>
                <p class="exp-company">{education.school}</p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 4: Interactive Technical Stack Matrix -->
  <section class="band band-surface" id="skills">
    <div class="shell">
      <div class="band-header">
        <h2>Technical Stack</h2>
        <p>Filter capabilities by architectural layer.</p>
      </div>

      <TechStackMatrix client:load />
    </div>
  </section>

  <!-- Section 5: Direct Contact -->
  <section class="band band-white" id="contact">
    <div class="shell contact-wrap">
      <div class="contact-copy">
        <h2>Contact</h2>
        <p>Open to .NET Developer, Backend &amp; API Engineer, and Full-Stack roles.</p>
      </div>

      <div class="contact-table">
        <div class="contact-row">
          <span>Email</span>
          <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>
        <div class="contact-row">
          <span>GitHub</span>
          <a href={profile.socials.github} target="_blank" rel="noopener noreferrer">
            github.com/amhercos
          </a>
        </div>
        <div class="contact-row">
          <span>LinkedIn</span>
          <a href={profile.socials.linkedin} target="_blank" rel="noopener noreferrer">
            linkedin.com/in/amhercosaine
          </a>
        </div>
        <div class="contact-row">
          <span>Résumé</span>
          <div class="contact-resume-links">
            <a href="/resume">View résumé</a>
            <a href={resumePdfHref} download={resumePdfFilename}>Download PDF</a>
          </div>
        </div>
        <div class="contact-copy-row">
          <CopyEmailButton client:load variant="button" label="Copy Email Address" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
