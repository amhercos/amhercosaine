---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume, resumePdfFilename, resumePdfHref } from '../data/resume';

const githubLabel = resume.github.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const linkedinLabel = resume.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<BaseLayout
  title="Résumé"
  description={`${resume.name} — ${resume.headline}. Printable résumé and PDF download.`}
>
  <section class="shell resume-stage">
    <div class="resume-toolbar">
      <p class="section-path">Résumé</p>
      <div class="resume-actions">
        <a href="/resume" aria-current="page">View résumé</a>
        <a href={resumePdfHref} download={resumePdfFilename}>Download PDF</a>
      </div>
    </div>

    <article class="resume-sheet">
      <header class="resume-masthead">
        <p class="resume-kicker">Résumé</p>
        <h1>{resume.name}</h1>
        <p class="resume-headline">{resume.headline}</p>
        <ul class="resume-contact">
          <li><a href={`mailto:${resume.email}`}>{resume.email}</a></li>
          <li><a href={resume.github} target="_blank" rel="noopener noreferrer">{githubLabel}</a></li>
          <li>
            <a href={resume.linkedin} target="_blank" rel="noopener noreferrer">{linkedinLabel}</a>
          </li>
          <li>{resume.location}</li>
        </ul>
      </header>

      <section class="resume-block">
        <h2>Summary</h2>
        <p>{resume.summary}</p>
      </section>

      <section class="resume-block">
        <h2>Expertise</h2>
        <ul class="resume-expertise">
          {resume.expertise.map((item) => (
            <li>
              <strong>{item.title}</strong>
              <span>{item.detail}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="resume-block">
        <h2>Experience</h2>
        <ol class="resume-roles">
          {resume.roles.map((item) => (
            <li>
              <div class="resume-role-head">
                <h3>{item.role}</h3>
                <span>{item.period}</span>
              </div>
              <p class="resume-org">{item.org}</p>
              <ul>
                {item.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </section>

      <section class="resume-block">
        <h2>Skills</h2>
        <dl class="resume-skills">
          {resume.skills.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="resume-block">
        <h2>Selected systems</h2>
        <ul class="resume-systems">
          {resume.systems.map((item) => (
            <li>
              <strong>{item.name}</strong>
              <span>{item.line}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="resume-block resume-education">
        <h2>Education</h2>
        <div class="resume-role-head">
          <h3>{resume.education.degree}</h3>
          <span>{resume.education.period}</span>
        </div>
        <p class="resume-org">{resume.education.school}</p>
      </section>
    </article>
  </section>
</BaseLayout>

<style is:global>
  .page-resume .resume-stage {
    padding: clamp(1.6rem, 4vw, 2.8rem) 0 4.2rem;
  }

  .resume-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.7rem 1.2rem;
    margin-bottom: 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--faint);
  }

  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.15rem;
  }

  .resume-actions a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    transition:
      color 200ms var(--ease),
      transform 200ms var(--ease);
  }

  .resume-actions a:hover,
  .resume-actions a:focus-visible,
  .resume-actions a[aria-current='page'] {
    color: var(--cyan);
  }

  .resume-actions a:hover,
  .resume-actions a:focus-visible {
    transform: translateY(-1px);
  }

  .resume-sheet {
    max-width: 210mm;
    margin-inline: auto;
    padding: clamp(1.6rem, 3.6vw, 2.15rem) clamp(1.45rem, 3.4vw, 2.1rem) 2rem;
    background: #f4efe6;
    color: #1b242c;
    border: 1px solid var(--line-strong);
    box-shadow: 0 28px 64px rgba(0, 0, 0, 0.38);
  }

  .resume-masthead {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(27, 36, 44, 0.14);
  }

  .resume-kicker {
    margin: 0 0 0.45rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4d5c66;
  }

  .resume-sheet h1 {
    color: #11181e;
    font-size: clamp(1.7rem, 3.4vw, 2.15rem);
    margin: 0 0 0.28rem;
  }

  .resume-headline {
    margin: 0 0 0.75rem;
    color: #1d4f4d;
    font-weight: 500;
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    padding: 0;
    list-style: none;
    font-size: 0.86rem;
    color: #3d4a53;
  }

  .resume-contact a {
    color: #145c59;
    text-decoration: underline;
    text-underline-offset: 0.16em;
    overflow-wrap: anywhere;
  }

  /* Phone tap targets only — print/PDF keep compact contact lines. */
  @media screen and (max-width: 800px) {
    .resume-contact {
      gap: 0.15rem 1rem;
    }

    .resume-contact a {
      display: inline-block;
      box-sizing: border-box;
      min-height: 2.75rem;
      padding-block: 0.7rem;
      max-width: 100%;
      vertical-align: middle;
    }
  }

  .resume-block {
    margin-top: 1.25rem;
  }

  .resume-expertise,
  .resume-systems {
    display: grid;
    gap: 0.7rem;
    padding: 0;
    list-style: none;
  }

  .resume-expertise li,
  .resume-systems li {
    display: grid;
    gap: 0.18rem;
  }

  .resume-expertise strong,
  .resume-systems strong {
    color: #11181e;
    font-weight: 600;
  }

  .resume-expertise span,
  .resume-systems span {
    color: #243038;
  }

  .resume-sheet h2 {
    margin: 0 0 0.45rem;
    color: #145c59;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .resume-sheet h3 {
    color: #11181e;
    font-size: 1rem;
    margin: 0;
  }

  .resume-sheet p,
  .resume-sheet li,
  .resume-sheet dd {
    color: #243038;
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .resume-roles {
    display: grid;
    gap: 1.15rem;
    padding: 0;
    list-style: none;
  }

  .resume-role-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.2rem 1rem;
    align-items: baseline;
  }

  .resume-role-head span {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: #4d5c66;
    font-variant-numeric: tabular-nums;
  }

  .resume-org {
    margin: 0.12rem 0 0.35rem;
    font-weight: 500;
    color: #1b242c;
  }

  .resume-roles ul {
    display: grid;
    gap: 0.38rem;
    padding-left: 1.15rem;
  }

  .resume-skills {
    display: grid;
    gap: 0.4rem;
    margin: 0;
  }

  .resume-skills div {
    display: grid;
    grid-template-columns: 8.2rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: baseline;
  }

  .resume-skills dt {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4d5c66;
  }

  .resume-education .resume-org {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .resume-skills div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .resume-sheet {
      padding: 1.35rem 1.1rem 1.6rem;
    }
  }

  @media print {
    html,
    body.page-resume,
    .page-resume .site-frame {
      background: #fff !important;
      color: #1b242c;
    }

    .page-resume .skip-link,
    .page-resume .site-chrome,
    .page-resume .site-footer,
    .page-resume .resume-toolbar {
      display: none !important;
    }

    .page-resume .site-frame {
      min-height: 0;
      border: 0;
    }

    .page-resume .resume-stage {
      width: 100%;
      max-width: none;
      padding: 0;
      margin: 0;
    }

    .page-resume .resume-sheet {
      max-width: none;
      margin: 0;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: #fff;
    }

    .page-resume .resume-headline,
    .page-resume .resume-sheet h2,
    .page-resume .resume-contact a {
      color: #145c59;
    }

    .page-resume .resume-contact a {
      display: inline;
      min-height: 0;
      padding: 0;
      vertical-align: baseline;
    }

    .page-resume .resume-sheet h1,
    .page-resume .resume-sheet h3,
    .page-resume .resume-expertise strong,
    .page-resume .resume-systems strong {
      color: #11181e;
    }

    .page-resume .resume-block {
      margin-top: 11pt;
    }

    .page-resume .resume-roles {
      gap: 10pt;
    }

    .page-resume .resume-expertise,
    .page-resume .resume-systems {
      gap: 8pt;
    }

    .page-resume .resume-roles > li,
    .page-resume .resume-expertise > li,
    .page-resume .resume-block {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .page-resume .resume-sheet p,
    .page-resume .resume-sheet li,
    .page-resume .resume-sheet dd {
      font-size: 10pt;
      line-height: 1.45;
    }

    .page-resume .resume-sheet h1 {
      font-size: 20pt;
      margin-bottom: 4pt;
    }

    .page-resume .resume-headline {
      font-size: 11pt;
      margin-bottom: 8pt;
    }

    .page-resume .resume-contact {
      gap: 4pt 12pt;
      font-size: 9.5pt;
    }

    .page-resume .resume-sheet h2 {
      font-size: 9pt;
      margin-bottom: 6pt;
    }

    .page-resume .resume-roles ul {
      gap: 4pt;
    }

    .page-resume .motion-ready [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .resume-actions a {
      transition: none;
      transform: none;
    }
  }

  @page {
    size: A4;
    margin: 16mm 18mm 18mm 18mm;
  }
</style>
