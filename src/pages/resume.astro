---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume, resumePdfFilename, resumePdfHref } from '../data/resume';

const githubLabel = resume.github.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const linkedinLabel = resume.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<BaseLayout
  title="Résumé"
  description={`${resume.name} — ${resume.headline}. Printable résumé and PDF download.`}
>
  <section class="band band-surface resume-stage">
    <div class="shell">
      <div class="resume-toolbar">
        <a class="case-back" href="/">← Back to portfolio</a>
        <div class="resume-actions">
          <a href="/resume" aria-current="page">View résumé</a>
          <a href={resumePdfHref} download={resumePdfFilename}>Download PDF</a>
        </div>
      </div>

      <article class="resume-sheet">
        <header class="resume-masthead">
          <h1>{resume.name}</h1>
          <p class="resume-headline">{resume.headline}</p>
          <ul class="resume-contact">
            <li><a href={`mailto:${resume.email}`}>{resume.email}</a></li>
            <li><a href={resume.github} target="_blank" rel="noopener noreferrer">{githubLabel}</a></li>
            <li>
              <a href={resume.linkedin} target="_blank" rel="noopener noreferrer">{linkedinLabel}</a>
            </li>
            <li>{resume.location}</li>
          </ul>
        </header>

        <section class="resume-block">
          <h2>Summary</h2>
          <p>{resume.summary}</p>
        </section>

        <section class="resume-block">
          <h2>Technical Stack</h2>
          <dl class="resume-skills">
            {resume.skills.map((group) => (
              <div>
                <dt>{group.label}</dt>
                <dd>{group.items.join(', ')}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="resume-block">
          <h2>Experience</h2>
          <ol class="resume-roles">
            {resume.roles.map((item) => (
              <li>
                <div class="resume-role-head">
                  <h3>{item.role}</h3>
                  <span>{item.period}</span>
                </div>
                <p class="resume-org">{item.org}</p>
                <ul>
                  {item.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </section>

        <section class="resume-block resume-education">
          <h2>Education</h2>
          <div class="resume-role-head">
            <h3>{resume.education.degree}</h3>
            <span>{resume.education.period}</span>
          </div>
          <p class="resume-org">{resume.education.school}</p>
        </section>
      </article>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .page-resume .resume-stage {
    padding: clamp(1.75rem, 4vw, 3rem) 0 4.5rem;
  }

  .resume-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    max-width: 210mm;
    margin: 0 auto 1.15rem;
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .resume-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.25rem;
  }

  .resume-actions a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .resume-actions a:hover,
  .resume-actions a[aria-current='page'] {
    color: var(--accent);
  }

  .resume-sheet {
    max-width: 210mm;
    margin-inline: auto;
    padding: clamp(1.5rem, 3.6vw, 2.35rem) clamp(1.25rem, 3.2vw, 2.25rem) 2.2rem;
    background: var(--bg-white);
    color: var(--ink-secondary);
    border: 1px solid var(--border);
  }

  .resume-masthead {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-strong);
  }

  .resume-sheet h1 {
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(1.85rem, 3.6vw, 2.3rem);
    letter-spacing: -0.03em;
    margin: 0 0 0.25rem;
  }

  .resume-headline {
    margin: 0 0 0.7rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--accent);
    font-weight: 500;
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .resume-contact a {
    color: var(--ink);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }

  .resume-block {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .resume-masthead + .resume-block {
    border-top: 0;
    padding-top: 0;
  }

  .resume-sheet h2 {
    margin: 0 0 0.55rem;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .resume-sheet h3 {
    color: var(--ink);
    font-size: 1rem;
    margin: 0;
  }

  .resume-sheet p,
  .resume-sheet li,
  .resume-sheet dd {
    color: var(--ink-secondary);
    font-size: 0.90625rem;
    line-height: 1.5;
  }

  .resume-roles {
    display: grid;
    gap: 1.15rem;
    padding: 0;
    list-style: none;
  }

  .resume-role-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.2rem 1rem;
    align-items: baseline;
  }

  .resume-role-head span {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .resume-org {
    margin: 0.12rem 0 0.4rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink);
  }

  .resume-roles ul {
    display: grid;
    gap: 0.35rem;
    padding-left: 1.15rem;
  }

  .resume-skills {
    display: grid;
    gap: 0.45rem;
    margin: 0;
  }

  .resume-skills div {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr);
    gap: 0.4rem 1rem;
    align-items: baseline;
  }

  .resume-skills dt {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .resume-skills dd {
    margin: 0;
  }

  @media (max-width: 640px) {
    .resume-skills div {
      grid-template-columns: 1fr;
      gap: 0.18rem;
    }
  }

  @media print {
    html,
    body.page-resume,
    .page-resume .site-frame {
      background: #ffffff !important;
      color: #09090b !important;
    }

    .page-resume .skip-link,
    .page-resume .site-chrome,
    .page-resume .site-footer,
    .page-resume .resume-toolbar {
      display: none !important;
    }

    .page-resume .resume-stage {
      padding: 0 !important;
      background: #ffffff !important;
    }

    .page-resume .shell {
      width: 100%;
      max-width: none;
    }

    .page-resume .resume-sheet {
      max-width: none;
      border: 0;
      padding: 0;
      background: #ffffff !important;
    }

    .page-resume .resume-sheet h1,
    .page-resume .resume-sheet h2,
    .page-resume .resume-sheet h3,
    .page-resume .resume-org {
      color: #09090b !important;
    }

    .page-resume .resume-headline,
    .page-resume .resume-contact a {
      color: #1d4ed8 !important;
    }

    .page-resume .resume-sheet p,
    .page-resume .resume-sheet li,
    .page-resume .resume-sheet dd {
      color: #3f3f46 !important;
      font-size: 9.2pt;
      line-height: 1.38;
    }

    .page-resume .resume-roles > li,
    .page-resume .resume-block,
    .page-resume .resume-skills div {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .page-resume .resume-sheet h1 {
      font-size: 19pt;
    }

    .page-resume .resume-skills div {
      grid-template-columns: 11.5rem minmax(0, 1fr);
    }
  }

  @page {
    size: A4;
    margin: 13mm 15mm 14mm 15mm;
  }
</style>
