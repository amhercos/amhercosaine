---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchitectureBoard from '../../components/ArchitectureBoard.tsx';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const canonical = new URL(`/work/${project.id}`, Astro.site);

const extraJsonLd = {
  '@type': 'Article',
  headline: project.data.title,
  description: project.data.summary,
  url: canonical.href,
  inLanguage: 'en',
  author: { '@id': `${new URL('/#person', Astro.site)}` },
  about: project.data.stack,
};
---

<BaseLayout
  title={project.data.title}
  description={project.data.summary}
  ogType="article"
  extraJsonLd={extraJsonLd}
>
  <article class="band band-white case-article">
    <div class="shell">
      <div class="case-nav">
        <a class="case-back" href="/#systems">← Back to portfolio</a>
        <p class="section-path">/work/{project.id}</p>
      </div>

      <h1 class="case-title">{project.data.title}</h1>
      <p class="case-summary">{project.data.summary}</p>

      <dl class="case-meta-grid">
        <div>
          <dt>Role</dt>
          <dd>{project.data.role}</dd>
        </div>
        <div>
          <dt>Period</dt>
          <dd>{project.data.period}</dd>
        </div>
        <div>
          <dt>Classification</dt>
          <dd>{project.data.type}</dd>
        </div>
        {project.data.confidential && (
          <div>
            <dt>Visibility</dt>
            <dd>Client details withheld</dd>
          </div>
        )}
        {project.data.repo && (
          <div>
            <dt>Repository</dt>
            <dd>
              <a
                href={project.data.repo}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${project.data.title} repository (opens in a new tab)`}
              >
                View source →
              </a>
            </dd>
          </div>
        )}
      </dl>

      <p class="stack-inline case-stack-line">{project.data.stack.join(', ')}</p>
    </div>
  </article>

  <section class="band band-surface case-studio-band">
    <div class="shell">
      <div class="band-header">
        <h2>Gane-Sarson Data Flow Diagram</h2>
        <p>Simulate the data flow or select any node to inspect stack details and outcomes.</p>
      </div>
      <ArchitectureBoard client:load slug={project.id} />
    </div>
  </section>

  <section class="band band-white case-prose-band">
    <div class="shell">
      <div class="prose">
        <Content />
      </div>

      <p class="case-discuss">
        <a class="plain-case-link" href="/#contact">Discuss this build →</a>
      </p>
    </div>
  </section>
</BaseLayout>
