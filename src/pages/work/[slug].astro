---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="shell case-hero">
    <a class="case-back" href="/#work">All systems</a>
    <p class="section-path">/work/{project.id}</p>
    <h1>{project.data.title}</h1>
    <p class="hero-intro">{project.data.summary}</p>
    <div class="case-meta">
      <span><strong>Role</strong>{project.data.role}</span>
      <span><strong>Period</strong>{project.data.period}</span>
      <span><strong>Type</strong>{project.data.type}</span>
      {project.data.confidential && (
        <span><strong>Visibility</strong>Confidential · employer withheld</span>
      )}
      {project.data.repo && (
        <a href={project.data.repo} target="_blank" rel="noreferrer">
          <strong>Repository</strong>View source
        </a>
      )}
    </div>
    <div class="project-stack">
      {project.data.stack.map((item) => <span>{item}</span>)}
    </div>
    <ArchitectureDiagram slug={project.id} />
    <div class="prose">
      <Content />
      <p><a class="text-link" href="/#contact">Discuss this build</a></p>
    </div>
  </article>
</BaseLayout>
